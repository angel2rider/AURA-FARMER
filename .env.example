# Discord application (Developer Portal → your app → Bot)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands instantly in this guild.
DISCORD_GUILD_ID=
# Optional first-run fallback until channels are set in the admin panel.
DISCORD_CHANNEL_ID=

# Cloudflare Worker backend
AURA_BOT_WORKER_URL=https://aura-farmer.example.workers.dev
AURA_BOT_INGEST_TOKEN=

# Optional overrides
OUTBOX_PATH=/data/outbox.json
STATE_PATH=/data/state.json
HEALTH_PORT=9099
LOG_LEVEL=info
